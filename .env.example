# Copy to .env for local runs. Never commit real credentials.
BANK=demo-retail-bank
# SUITE=smoke            # build | sit | smoke (omit = everything the bank has)
# WORKERS=2

# Credentials: Vault wins, then BANK_USERNAME/BANK_PASSWORD, else a demo user is provisioned.
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=
# VAULT_MOUNT=secret     # secret read from <mount>/data/banks/<bank>
# BANK_USERNAME=
# BANK_PASSWORD=

# Required only when env.json has "production": true
# APPROVED_BY=jane.pm
